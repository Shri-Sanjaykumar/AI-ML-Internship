# ==============================================================================
# Linkific Enterprise AI & Workflow Automation Service
# Production Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to '.env' and adjust the configuration values for your environment.
# DO NOT commit sensitive production credentials to public version control.

# Application Identity & Deployment Stage
APP_NAME="Linkific Enterprise Automation Service"
APP_VERSION="1.0.0"
ENVIRONMENT="development"  # Options: development, staging, production
DEBUG=false

# Networking & Server Runtime
HOST="0.0.0.0"
PORT=8000
WORKERS=2

# Security & Authentication
# Required: Secret API Key for authenticating protected microservice endpoints.
# In production, use a high-entropy string (min 24 characters).
API_KEY="linkific-sec-prod-key-2026-xyz"
CORS_ORIGINS='["http://localhost:3000","https://www.linkific.in","https://app.linkific.in"]'

# Structured Logging & Audit Trail
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL="INFO"
# Options: json (production-recommended for Datadog/ELK/CloudWatch) or text (local human-readable)
LOG_FORMAT="json"
LOG_FILE_PATH="data/service.log"
LOG_ROTATION_BYTES=10485760  # 10 MB per log file
LOG_BACKUP_COUNT=5

# Document Corpus & Data Ingestion
DOCS_CORPUS_PATH="data/company_docs.json"

# Observability & Monitoring
METRICS_ENABLED=true
RATE_LIMIT_PER_MINUTE=120

# Multi-Agent Workflow Engine Controls
MAX_WORKFLOW_REVISIONS=2
CRITIC_APPROVAL_THRESHOLD=0.80
