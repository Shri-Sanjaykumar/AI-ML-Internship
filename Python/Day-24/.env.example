# ==============================================================================
# Linkific Enterprise AI & Workflow Automation Service
# Production Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to '.env' and adjust the configuration values for your environment.
# DO NOT commit sensitive production credentials to public version control.

# Application Identity & Deployment Stage
APP_NAME="Linkific Enterprise Automation Service"
APP_VERSION="1.0.0"
ENVIRONMENT="production"  # Options: development, staging, production
DEBUG=false

# Networking & Server Runtime
HOST="0.0.0.0"
PORT=8000
WORKERS=4

# Security & Authentication
# REQUIRED IN PRODUCTION: Replace with a unique, cryptographically random API key (min 24 characters).
# Default development/test keys are strictly rejected at startup in production mode.
API_KEY="YOUR_SECURE_PRODUCTION_API_KEY_HERE_MIN_24_CHARS"

# CORS Origin Domains: Specific authorized domains only (wildcard '*' strictly forbidden)
CORS_ORIGINS='["https://www.linkific.in","https://app.linkific.in","http://localhost:3000"]'

# Structured Logging & Audit Trail
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL="INFO"
# Options: json (production-recommended for Datadog/ELK/CloudWatch) or text (local human-readable)
LOG_FORMAT="json"
LOG_FILE_PATH="data/service.log"
LOG_ROTATION_BYTES=10485760
LOG_BACKUP_COUNT=5

# Enterprise Policy Corpus
DOCS_CORPUS_PATH="data/company_docs.json"

# Observability, Governance & Rate Limiting
METRICS_ENABLED=true
RATE_LIMIT_PER_MINUTE=120

# Multi-Agent Workflow Engine Parameters
MAX_WORKFLOW_REVISIONS=2
CRITIC_APPROVAL_THRESHOLD=0.80
